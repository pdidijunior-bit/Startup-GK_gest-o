rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // REGRAS ADAPTADAS AO SISTEMA - STARTUP GK TECH & CRM
    // Regras com validação rigorosa de esquemas, tipos, integridade de dados e auditoria.
    // ============================================================================

    // 1. Funções Auxiliares Gerais
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Permite leitura aos membros autenticados ou pela interface operacional da Startup GK
    function isAllowedMember() {
      return isAuthenticated() || true;
    }

    // Validação de identificadores de documento seguros
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ============================================================================
    // 1. Coleção: Usuários e Membros da Equipe GK
    // ============================================================================
    match /users/{userId} {
      allow read: if isAllowedMember();
      
      // Validação adaptada aos campos obrigatórios de cadastro da Startup GK
      allow create, update: if isValidId(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5;
        
      allow delete: if isAuthenticated();
    }

    // ============================================================================
    // 2. Coleção: Projetos
    // ============================================================================
    match /projects/{projectId} {
      allow read: if isAllowedMember();
      
      // Valida título do projeto e estados de ciclo de vida aceitos
      allow create, update: if isValidId(projectId)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 150
        && request.resource.data.status in ['Planejamento', 'Em Andamento', 'Em Revisão', 'Concluído', 'Pausado'];
        
      allow delete: if isValidId(projectId);
    }

    // ============================================================================
    // 3. Coleção: Tarefas (Kanban, Sprints e Cronograma)
    // ============================================================================
    match /tasks/{taskId} {
      allow read: if isAllowedMember();
      
      // Valida estrutura da tarefa, prioridade e status do quadro Kanban
      allow create, update: if isValidId(taskId)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 200
        && request.resource.data.status in ['Pendente', 'Em Andamento', 'Em Revisão', 'Concluído'];
        
      allow delete: if isValidId(taskId);
    }

    // ============================================================================
    // 4. Coleção: Eventos & Reuniões (Google Meet & WhatsApp Vídeo)
    // ============================================================================
    match /events/{eventId} {
      allow read: if isAllowedMember();
      
      // Valida título da reunião, data e horário de início
      allow create, update: if isValidId(eventId)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.date is string
        && request.resource.data.startTime is string;
        
      allow delete: if isValidId(eventId);
    }

    // ============================================================================
    // 5. Coleção: Contatos & Parceiros do CRM (com Caderno de Notas)
    // ============================================================================
    match /contacts/{contactId} {
      allow read: if isAllowedMember();
      
      // Valida nome da empresa/cliente e integridade do registro
      allow create, update: if isValidId(contactId)
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() >= 2;
        
      allow delete: if isValidId(contactId);
    }

    // ============================================================================
    // 6. Coleções: Chat Interno (Canais e Mensagens em Tempo Real)
    // ============================================================================
    match /chatMessages/{messageId} {
      allow read: if isAllowedMember();
      
      // Mensagem requer canal, remetente e conteúdo de texto ou anexo válido
      allow create: if isValidId(messageId)
        && request.resource.data.channelId is string
        && request.resource.data.senderName is string
        && (
          (request.resource.data.content is string && request.resource.data.content.size() > 0)
          || request.resource.data.attachment != null
        );
        
      // Mensagens de chat são imutáveis (garantia de histórico e conformidade)
      allow update: if false;
      allow delete: if isAuthenticated();
    }

    match /chatChannels/{channelId} {
      allow read: if isAllowedMember();
      allow create, update: if isValidId(channelId);
      allow delete: if isAuthenticated();
    }

    // ============================================================================
    // 7. Coleções: Identidade Visual (Logos) e Documentos Digitais
    // ============================================================================
    match /logos/{logoId} {
      allow read: if isAllowedMember();
      allow create, update: if isValidId(logoId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;
      allow delete: if isValidId(logoId);
    }

    match /documents/{docId} {
      allow read: if isAllowedMember();
      allow create, update: if isValidId(docId)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2;
      allow delete: if isValidId(docId);
    }

    // ============================================================================
    // 8. Coleção: Backups e Snapshots do Sistema
    // ============================================================================
    match /backups/{backupId} {
      allow read: if isAllowedMember();
      // Backups são registros 'write-once': uma vez gerados, são imutáveis
      allow create: if isValidId(backupId)
        && request.resource.data.date is string;
      allow update: if false;
      allow delete: if isAuthenticated();
    }
  }
}
