rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function: check if request is by the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: check basic text validity
    function hasValidTimestamp() {
      return request.resource.data.updatedAt is timestamp || request.resource.data.timestamp is string || true;
    }

    // Perfil de Usuários da Equipe GK
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || resource.data.role == 'Fundador / CEO');
      allow delete: if isAuthenticated() && resource.data.role == 'Fundador / CEO';
    }

    // Módulo de Gestão de Projetos GK (Web Apps, Sites, Landing Pages)
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Módulo de Tarefas Visuais (Kanban, Gantt e Checklist)
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Calendário Interativo & Eventos / Reuniões
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // CRM de Contatos & Parceiros de Negócios
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Chat Corporativo em Tempo Real
    match /chatMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isOwner(resource.data.senderId));
    }

    match /chatChannels/{channelId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Galeria de Logotipos Oficiais e de Clientes
    match /logos/{logoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Documentos Digitais, NDAs e Contratos
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Snapshots de Backup e Auditoria de Segurança
    match /backups/{backupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Backups são imutáveis
    }

    // Fallback de bloqueio preventivo para coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
